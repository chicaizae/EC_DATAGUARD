# Build
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY src/Contracts/EcDataguard.Contracts.csproj src/Contracts/
COPY src/Server/EcDataguard.Web/EcDataguard.Web.csproj src/Server/EcDataguard.Web/

RUN dotnet restore src/Server/EcDataguard.Web/EcDataguard.Web.csproj

COPY src/ src/
RUN dotnet publish src/Server/EcDataguard.Web/EcDataguard.Web.csproj -c Release -o /out

# Runtime
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app
EXPOSE 8080
COPY --from=build /out .
ENV ASPNETCORE_URLS=http://+:8080
ENTRYPOINT ["dotnet", "EcDataguard.Web.dll"]